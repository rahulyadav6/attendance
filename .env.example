# ─── Copy this file to .env.local and fill in your values ───

# MongoDB connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/attendiq
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/attendiq

# JWT Secret — use any long random string
# Example: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# App URL (used for QR code links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
